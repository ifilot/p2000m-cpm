10 S=0
20 FOR I=1 TO 10
30 S=S+I*I
40 NEXT I
50 IF S<>385 THEN PRINT "BASIC MATH FAIL":SYSTEM
60 OPEN "O",#1,"BASOUT.TXT"
70 PRINT #1,"BASIC DISK OK"
80 CLOSE #1
90 OPEN "I",#1,"BASOUT.TXT"
100 LINE INPUT #1,A$
110 CLOSE #1
120 IF A$<>"BASIC DISK OK" THEN PRINT "BASIC FILE FAIL":SYSTEM
130 PRINT "BASIC EXECUTION PASS"
140 SYSTEM
